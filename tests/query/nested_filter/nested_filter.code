schema {
  type Author {
    name: String
    wrote: WROTE -> Book[]
  }
  type Book {
    title: String
    year: Int
    author: WROTE <- Author
  }
}

mutation {
  Author(name: "Ursula") {
    wrote -> Book(title: "Earthsea" && year: 1968)
    wrote -> Book(title: "Dispossessed" && year: 1974)
  }
}

mutation {
  Author(name: "Octavia") { wrote -> Book(title: "Kindred" && year: 1979) }
}

query {
  Author(name: "Ursula") {
    wrote -> Book(year >= 1970) {
      title
      year
    }
  }
}
