schema {
  type Depot { name: String road -> Junction[] { km: Float } }
  type Junction { name: String at: Point road -> Junction[] { km: Float } }
}
mutation { Depot(name: "D") { road -> Junction(name: "J" && at: point(51.0, -114.0)) { name &km: 0.001 } } }
query { Depot { road *path by &km toward at in km -> Junction { name } } }
