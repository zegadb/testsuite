schema {
  type Junction {
    name: String
    road -> Junction[] { km?: Float }
  }
}

mutation {
  Junction(name: "A")
}

mutation {
  Junction(name: "B")
}

mutation {
  Junction(name: "C")
}

mutation {
  Junction(name: "A") {
    road -> link Junction(name: "B") { &km: 1.0 }
  }
}

mutation {
  Junction(name: "B") {
    road -> link Junction(name: "C") { name }
  }
}

query {
  Junction(name: "A") {
    road *path by &km -> Junction(name: "C") { name }
  }
}
