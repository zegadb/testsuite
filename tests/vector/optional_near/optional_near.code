schema {
  type Ticket {
    n: Int
    embedding?: Vector<2>
  }
}

mutation {
  Ticket(n: 0) { n }
}

mutation {
  Ticket(n: 1 && embedding: @vector[1, 0]) { n }
}

mutation {
  Ticket(n: 2 && embedding: @vector[0, 1]) { n }
}

query {
  Ticket @near(embedding, @vector[1, 0], 3) {
    n
    @score
  }
}
