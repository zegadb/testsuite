schema { type Queue { name: String tickets -> Ticket[] } type Ticket { n: Int embedding: Vector<3> } }
mutation { Queue(name: "inbox") { tickets -> Ticket(n: 0 && embedding: vector[1,0,0]) { n } tickets -> Ticket(n: 1 && embedding: vector[0,1,0]) { n } tickets -> Ticket(n: 2 && embedding: vector[-1,0,0]) { n } } }
query { Queue(name: "inbox") { tickets -> Ticket(n > 0) near(embedding, vector[1,0,0], 1) { n score } } }
