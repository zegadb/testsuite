schema {
  type Ticket {
    n: Int
    embedding: Vector<3>
  }
}

mutation {
  Ticket(n: 0 && embedding: @vector[1, 0, 0]) { n }
}

mutation {
  Ticket(n: 1 && embedding: @vector[0, 1, 0]) { n }
}

mutation {
  Ticket(n: 2 && embedding: @vector[-1, 0, 0]) { n }
}

mutation {
  Ticket(n: 0) set embedding: @vector[-1, 0, 0] { n }
}

query {
  Ticket @near(embedding, @vector[1, 0, 0], 2) {
    n
    @score
  }
}
