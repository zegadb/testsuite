schema {
  type Team {
    name: String
    players -> Player[]
  }

  type Player {
    name: String
    salary?: Int
    players <- Team
  }
}

mutation {
  Player(name: "Ada" && salary: 300)
}

mutation {
  Player(name: "Ben" && salary: 100)
}

mutation {
  Player(name: "Cy")
}

mutation {
  Player(name: "Dee" && salary: 300)
}

mutation {
  Team(name: "Oilers")
}

mutation {
  Team(name: "Oilers") {
    players -> link Player(name: "Ada")
  }
}

mutation {
  delete Player(salary = 300)
}
